<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The friend flavor never makes a network call (every call site is gated
         on BuildConfig.ENABLE_CLOUD_FEATURES, which is false here) — so it
         shouldn't request INTERNET either. Nothing to trust, nothing to ask for. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

</manifest>
