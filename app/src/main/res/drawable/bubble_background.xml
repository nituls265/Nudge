<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!--
      Makes it a circle/pill shape.
      Matches Tailwind 'rounded-full'
    -->
    <corners android:radius="999dp" />

    <!--
      Frost Gradient:
      from-teal-400/30 (#4D2DD4BF)
      to-emerald-400/30 (#4D34D399)
      Angle 315 matches bg-gradient-to-br (top-left to bottom-right)
    -->
    <gradient
        android:angle="315"
        android:startColor="@color/frost_start"
        android:endColor="@color/frost_end"
        android:type="linear" />

    <!--
      Frost Border:
      border-white/30
    -->
    <stroke
        android:width="1dp"
        android:color="#4DFFFFFF" />

    <!-- Optional padding to match your layout needs -->
    <padding
        android:left="16dp"
        android:top="16dp"
        android:right="16dp"
        android:bottom="16dp" />
</shape>