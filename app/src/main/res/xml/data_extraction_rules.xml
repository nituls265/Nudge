<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. Only the calibration start date and the history database are backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="NudgeCalibration.xml" />
        <include domain="database" path="scroll_database" />
        <include domain="database" path="scroll_database-wal" />
        <include domain="database" path="scroll_database-shm" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="NudgeCalibration.xml" />
        <include domain="database" path="scroll_database" />
        <include domain="database" path="scroll_database-wal" />
        <include domain="database" path="scroll_database-shm" />
    </device-transfer>
</data-extraction-rules>
